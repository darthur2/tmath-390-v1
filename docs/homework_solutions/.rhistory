#P(S) = 0.2, P(H) = 0.8
spam <- 0.2
ham <- 0.8
type <- c("Spam","Ham")
words <- c("Free","Emoji","Won","Giveaway","Sale","Caps","W1","W2","W3")
s_prob <- c(0.3,0.5,0.3,0.6,0.3,0.4,0.3,0.2,0.3)
h_prob <- c(0.1,0.2,0.2,0.2,0.25,0.3,0.4,0.3,0.5)
df <- data.frame(words,s_prob,h_prob)
df
#P(W_k)
df[[3,2]]
p_words_given_spam <- prod(df[[3,2]],df[[6,2]],df[[3,2]],df[[2,2]],df[[2,2]],df[[9,2]],df[[1,2]])
p_words_given_ham <- prod(df[[3,3]],df[[6,3]],df[[3,3]],df[[2,3]],df[[2,3]],df[[9,3]],df[[1,3]])
p_words <- p_words_given_spam*spam + p_words_given_ham*ham
p_words
p_spam_given_words <- p_words_given_spam*spam/p_words
p_spam_given_words
#bayes activity
#these are the words given in order
spam_words <- c(.3, .4, .3, .5, .5, .3, .3)
ham_words <- c(.2, .3, .2, .2, .2, .5, .1)
#this is the prob of having those words
#prob of it in ham * prob of it in spam
p_words <- prod(ham_words) * .8 + prod(spam_words) * .2
#prob of spam words given its spam and prob of spam
#all over the probability of words
(prod(spam_words) * .2) / p_words
